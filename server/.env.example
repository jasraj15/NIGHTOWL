# ───────────────────────────── NightOwl backend ─────────────────────────────
# Copy to server/.env for local development. Never commit the real .env file.

# Server
PORT=5000
NODE_ENV=development

# Origins allowed for CORS + Socket.IO (comma-separate extra preview URLs)
CLIENT_URL=http://localhost:5173
EXTRA_ALLOWED_ORIGINS=

# MongoDB (local or Atlas). Example Atlas URI:
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nightowl?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/nightowl

# Session cookie signing secret — at least 16 chars; use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# Leave empty unless your API and frontend share a parent domain
COOKIE_DOMAIN=

# Email OTP via Resend (https://resend.com). Leave empty in development:
# the server then prints the OTP to the console and returns it as `debugOtp`.
RESEND_API_KEY=
EMAIL_FROM=NightOwl <onboarding@resend.dev>
COLLEGE_EMAIL_DOMAIN=sst.scaler.com

# Razorpay (test mode keys start with rzp_test_). Dashboard → Settings → API Keys.
# When empty, online payments are disabled and the app falls back to host-verified UPI references.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → secret you chose when creating the webhook
RAZORPAY_WEBHOOK_SECRET=
# Only set true with an approved Razorpay Route account and KYC'd linked accounts for hosts
RAZORPAY_ROUTE_ENABLED=false

# Pool countdown limits (minutes)
POOL_MIN_DURATION_MINUTES=5
POOL_MAX_DURATION_MINUTES=180
