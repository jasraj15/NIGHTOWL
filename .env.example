# Server Port
PORT=5000

# Client Application URL (for CORS and Cookie security)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nightowl?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/nightowl

# JWT Secret for Session Cookies (Change to a strong random string in production)
JWT_SECRET=super_secret_nightowl_jwt_key_change_in_production_32char

# Cookie Settings
NODE_ENV=development
COOKIE_DOMAIN=localhost

# Resend API Key for Email OTP (https://resend.com)
# When empty or omitted in development, OTP will be printed to server console for testing
RESEND_API_KEY=
EMAIL_FROM=NightOwl <onboarding@resend.dev>

# College Email Domain enforcement ( SST Scaler )
COLLEGE_EMAIL_DOMAIN=sst.scaler.com
